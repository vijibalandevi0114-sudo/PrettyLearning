// ---------- floral background scatter (signature texture) ----------
function paintFloralBackground() {
  const holder = document.querySelector(".bg-scatter");
  if (!holder) return;
  const flowers = ["🌸", "🌼", "🌷", "🦋", "🌿", "✨"];
  const count = window.innerWidth < 700 ? 10 : 18;
  let html = "";
  for (let i = 0; i < count; i++) {
    const emoji = flowers[i % flowers.length];
    const top = Math.random() * 100;
    const left = Math.random() * 100;
    const size = 14 + Math.random() * 22;
    const rot = Math.random() * 360;
    html += `<span style="position:absolute;top:${top}%;left:${left}%;font-size:${size}px; transform:rotate(${rot}deg);opacity:${ 0.18 + Math.random() * 0.22 }">${emoji}</span>`;
  }
  holder.innerHTML = html;
}

// ---------- nav active state ----------
function markActiveNav() {
  const here = location.pathname.split("/").pop() || "index.html";
  document.querySelectorAll(".nav-links a").forEach((a) => {
    const target = a.getAttribute("href");
    if (target === here) a.classList.add("active");
  });
}

