/* =========================================================== PrettyLearning — Design tokens Palette: Blossom Pink #F6A6B2 · Meadow Green #7FB77E · Sunshine Yellow #FFD166 · Sky Lavender #B6A6E9 · Cream Petal #FFF8EF · Ink Plum #3B2F45 Display: 'Fredoka' Body: 'Quicksand' Utility: 'Nunito' Signature: the "Petal Path" — a winding dotted trail that guides the learner from section to section, page to page. =========================================================== */

@import url("https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Quicksand:wght@400;500;600;700&family=Nunito:wght@600;700;800&display=swap");

:root {
  --pink: #f6a6b2;
  --pink-deep: #e97f91;
  --green: #7fb77e;
  --green-deep: #5b9c5a;
  --yellow: #ffd166;
  --lavender: #b6a6e9;
  --cream: #fff8ef;
  --ink: #3b2f45;
  --ink-soft: #6b5c77;
  --white: #ffffff;
  --radius-lg: 28px;
  --radius-md: 18px;
  --radius-sm: 10px;
  --shadow: 0 10px 30px rgba(59, 47, 69, 0.1);
  --shadow-soft: 0 4px 14px rgba(59, 47, 69, 0.08);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Quicksand", sans-serif;
  background: var(--cream);
  color: var(--ink);
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
  line-height: 1.6;
}

h1,
h2,
h3,
h4 {
  font-family: "Fredoka", sans-serif;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.2;
}

a {
  text-decoration: none;
  color: inherit;
}
ul {
  list-style: none;
}
button {
  font-family: inherit;
  cursor: pointer;
  border: none;
}

.eyebrow {
  font-family: "Nunito", sans-serif;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-size: 0.72rem;
  color: var(--green-deep);
}

/* ---------- background floral scatter ---------- */
.bg-scatter {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}
.bg-scatter svg {
  position: absolute;
  opacity: 0.35;
}

/* ---------- header / nav ---------- */
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 248, 239, 0.92);
  backdrop-filter: blur(6px);
  border-bottom: 2px dashed var(--pink);
}
.nav-wrap {
  max-width: 1120px;
  margin: 0 auto;
  padding: 16px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: "Fredoka", sans-serif;
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--ink);
}
.brand .petal-mark {
  font-size: 1.5rem;
}
.brand .brand-pretty {
  color: var(--pink-deep);
}
.brand .brand-learning {
  color: var(--green-deep);
}

.nav-links {
  display: flex;
  gap: 6px;
  align-items: center;
  flex-wrap: wrap;
}
.nav-links a {
  font-family: "Nunito", sans-serif;
  font-weight: 700;
  font-size: 0.92rem;
  padding: 8px 14px;
  border-radius: 999px;
  color: var(--ink-soft);
  transition: all 0.18s ease;
}
.nav-links a:hover,
.nav-links a.active {
  background: var(--pink);
  color: var(--white);
}

/* ---------- buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: "Nunito", sans-serif;
  font-weight: 800;
  font-size: 0.95rem;
  padding: 13px 26px;
  border-radius: 999px;
  transition: transform 0.16s ease, box-shadow 0.16s ease;
  box-shadow: var(--shadow-soft);
}
.btn:hover {
  transform: translateY(-3px) rotate(-0.5deg);
}
.btn-primary {
  background: var(--pink-deep);
  color: var(--white);
}
.btn-primary:hover {
  box-shadow: 0 12px 24px rgba(233, 127, 145, 0.35);
}
.btn-secondary {
  background: var(--white);
  color: var(--ink);
  border: 2px solid var(--ink);
}
.btn-green {
  background: var(--green-deep);
  color: var(--white);
}
.btn-green:hover {
  box-shadow: 0 12px 24px rgba(91, 156, 90, 0.35);
}
.btn-yellow {
  background: var(--yellow);
  color: var(--ink);
}
.btn-lavender {
  background: var(--lavender);
  color: var(--white);
}
.btn-block {
  width: 100%;
  justify-content: center;
}
.btn[disabled] {
  opacity: 0.45;
  cursor: not-allowed;
  transform: none;
}

/* ---------- layout shells ---------- */
main {
  position: relative;
  z-index: 1;
}
.wrap {
  max-width: 1120px;
  margin: 0 auto;
  padding: 0 24px;
}
section {
  padding: 64px 0;
}

/* ---------- petal path (signature element) ---------- */
.petal-path {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin: 6px 0 40px;
  flex-wrap: wrap;
}
.petal-path .dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--pink);
}
.petal-path .flower {
  font-size: 1.1rem;
}

/* ---------- hero ---------- */
.hero {
  padding: 70px 0 40px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 40px;
  align-items: center;
}
.hero h1 {
  font-size: clamp(2.1rem, 4.2vw, 3.4rem);
  margin-bottom: 18px;
}
.hero h1 .underline {
  position: relative;
  color: var(--pink-deep);
}
.hero p.lead {
  font-size: 1.12rem;
  color: var(--ink-soft);
  max-width: 46ch;
  margin-bottom: 30px;
}
.hero-ctas {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}
.hero-art {
  position: relative;
  aspect-ratio: 1/1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* garden stage circle behind hero character */
.garden-stage {
  width: 88%;
  aspect-ratio: 1/1;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, #fff, var(--pink) 78%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: var(--shadow);
}
.garden-stage .big-emoji {
  font-size: 6.4rem;
  filter: drop-shadow(0 10px 14px rgba(0, 0, 0, 0.12));
}
.orbit-flower {
  position: absolute;
  font-size: 1.8rem;
  animation: float 5s ease-in-out infinite;
}
@keyframes float {
  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-10px) rotate(8deg);
  }
}
@media (prefers-reduced-motion: reduce) {
  .orbit-flower {
    animation: none;
  }
}

/* ---------- section headers ---------- */
.section-head {
  text-align: center;
  max-width: 640px;
  margin: 0 auto 44px;
}
.section-head h2 {
  font-size: clamp(1.6rem, 3vw, 2.3rem);
  margin: 8px 0 12px;
}
.section-head p {
  color: var(--ink-soft);
}

/* ---------- cards grid ---------- */
.grid {
  display: grid;
  gap: 26px;
}
.grid-3 {
  grid-template-columns: repeat(3, 1fr);
}
.grid-2 {
  grid-template-columns: repeat(2, 1fr);
}
.grid-4 {
  grid-template-columns: repeat(4, 1fr);
}

.card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 26px;
  box-shadow: var(--shadow-soft);
  border: 2px solid transparent;
  transition: transform 0.18s ease, border-color 0.18s ease,
    box-shadow 0.18s ease;
  display: flex;
  flex-direction: column;
}
.card:hover {
  transform: translateY(-6px);
  border-color: var(--pink);
  box-shadow: var(--shadow);
}

/* ---------- tutor avatar (css cartoon) ---------- */
.avatar {
  width: 108px;
  height: 108px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3rem;
  margin: 0 auto 16px;
  position: relative;
  box-shadow: inset 0 -6px 0 rgba(0, 0, 0, 0.06);
}
.avatar.bg-1 {
  background: var(--pink);
}
.avatar.bg-2 {
  background: var(--lavender);
}
.avatar.bg-3 {
  background: var(--yellow);
}
.avatar.bg-4 {
  background: var(--green);
}
.avatar.bg-5 {
  background: #ffc1cc;
}
.avatar.bg-6 {
  background: #a7d8d8;
}
.avatar .badge-ai {
  position: absolute;
  bottom: -4px;
  right: -4px;
  background: var(--ink);
  color: var(--white);
  font-family: "Nunito", sans-serif;
  font-size: 0.6rem;
  font-weight: 800;
  padding: 3px 7px;
  border-radius: 999px;
  border: 2px solid var(--white);
}

.tutor-name {
  text-align: center;
  font-size: 1.15rem;
  margin-bottom: 2px;
}
.tutor-role {
  text-align: center;
  color: var(--pink-deep);
  font-family: "Nunito", sans-serif;
  font-weight: 700;
  font-size: 0.82rem;
  margin-bottom: 12px;
}
.tutor-meta {
  font-size: 0.88rem;
  color: var(--ink-soft);
  margin-bottom: 14px;
  flex-grow: 1;
}
.tutor-meta li {
  margin-bottom: 6px;
  display: flex;
  gap: 8px;
}
.price-tag {
  display: inline-flex;
  align-items: baseline;
  gap: 4px;
  font-family: "Fredoka", sans-serif;
  background: var(--cream);
  border: 2px dashed var(--pink);
  border-radius: 999px;
  padding: 8px 16px;
  align-self: center;
  margin-bottom: 14px;
}
.price-tag .num {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--pink-deep);
}
.price-tag .unit {
  font-size: 0.78rem;
  color: var(--ink-soft);
}

/* ---------- pricing cards ---------- */
.plan-card {
  text-align: center;
  position: relative;
}
.plan-card.popular {
  border-color: var(--yellow);
}
.plan-card .ribbon {
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--yellow);
  color: var(--ink);
  font-family: "Nunito", sans-serif;
  font-weight: 800;
  font-size: 0.72rem;
  padding: 5px 14px;
  border-radius: 999px;
  box-shadow: var(--shadow-soft);
}
.plan-card h3 {
  font-size: 1.3rem;
  margin: 10px 0 4px;
}
.plan-price {
  font-family: "Fredoka", sans-serif;
  font-size: 2.2rem;
  color: var(--green-deep);
  margin: 6px 0;
}
.plan-price sup {
  font-size: 1rem;
}
.plan-price span {
  font-size: 0.9rem;
  color: var(--ink-soft);
  font-family: "Quicksand", sans-serif;
}
.plan-list {
  text-align: left;
  margin: 16px 0 22px;
}
.plan-list li {
  padding: 6px 0;
  font-size: 0.92rem;
  color: var(--ink-soft);
  display: flex;
  gap: 8px;
}

/* ---------- form ---------- */
.form-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 34px;
  box-shadow: var(--shadow);
  max-width: 620px;
  margin: 0 auto;
}
.field {
  margin-bottom: 18px;
}
.field label {
  display: block;
  font-family: "Nunito", sans-serif;
  font-weight: 700;
  font-size: 0.85rem;
  margin-bottom: 7px;
  color: var(--ink);
}
.field select,
.field input,
.field textarea {
  width: 100%;
  padding: 12px 14px;
  border-radius: var(--radius-sm);
  border: 2px solid #ede1d3;
  background: var(--cream);
  font-family: "Quicksand", sans-serif;
  font-size: 0.98rem;
  color: var(--ink);
}
.field select:focus,
.field input:focus,
.field textarea:focus {
  outline: 3px solid var(--lavender);
  border-color: var(--lavender);
}
.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.summary-box {
  background: var(--cream);
  border: 2px dashed var(--green);
  border-radius: var(--radius-md);
  padding: 18px;
  margin: 20px 0;
  font-size: 0.94rem;
}
.summary-box .line {
  display: flex;
  justify-content: space-between;
  padding: 4px 0;
}
.summary-box .total {
  font-weight: 800;
  font-family: "Nunito", sans-serif;
  border-top: 2px dashed var(--pink);
  margin-top: 8px;
  padding-top: 10px;
}

/* ---------- footer ---------- */
.site-footer {
  background: var(--ink);
  color: #f1e9ee;
  padding: 46px 0 26px;
  margin-top: 40px;
  position: relative;
  z-index: 1;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr;
  gap: 30px;
  margin-bottom: 26px;
}
.footer-grid h4 {
  color: #fff;
  font-size: 1rem;
  margin-bottom: 12px;
}
.footer-grid a {
  display: block;
  color: #cbb8cb;
  font-size: 0.9rem;
  padding: 4px 0;
}
.footer-grid a:hover {
  color: var(--yellow);
}
.footer-bottom {
  text-align: center;
  font-size: 0.8rem;
  color: #b39eb3;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  padding-top: 18px;
}

/* ---------- misc pages ---------- */
.banner {
  background: linear-gradient(120deg, var(--lavender), var(--pink));
  border-radius: var(--radius-lg);
  padding: 40px;
  color: var(--white);
  text-align: center;
  margin: 40px 0;
}
.banner h2 {
  color: #fff;
}
.confirm-box {
  text-align: center;
  max-width: 560px;
  margin: 0 auto;
}
.confirm-box .stamp {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3.2rem;
  margin: 0 auto 20px;
  box-shadow: var(--shadow);
}
.button-row {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 26px;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 44px;
  align-items: center;
}
.value-list li {
  margin-bottom: 14px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.value-list .emoji {
  font-size: 1.4rem;
}

/* ---------- responsive ---------- */
@media (max-width: 880px) {
  .hero {
    grid-template-columns: 1fr;
  }
  .grid-3,
  .grid-4,
  .grid-2 {
    grid-template-columns: 1fr 1fr;
  }
  .about-grid {
    grid-template-columns: 1fr;
  }
  .footer-grid {
    grid-template-columns: 1fr;
  }
  .field-row {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 560px) {
  .grid-3,
  .grid-4,
  .grid-2 {
    grid-template-columns: 1fr;
  }
  .nav-links {
    justify-content: center;
  }
}

/* focus visibility */
a:focus-visible,
button:focus-visible {
  outline: 3px solid var(--lavender);
  outline-offset: 2px;
}